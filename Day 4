public class Bigbasket {

	public static void main(String[] args) throws InterruptedException {
		// TODO Auto-generated method stub
		WebDriver driver = new EdgeDriver();
		driver.manage().window().maximize();
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(15));
		driver.navigate().to("https://www.bigbasket.com/pb/boss/");
		Thread.sleep(2000);
		
		//searching of a product
		driver.findElement(By.xpath("(//input[@placeholder='Search for Products...'])[2]")).sendKeys("Apple" , Keys.ENTER);
		
		//adding product to the cart
		driver.findElement(By.xpath("//h3[contains(.,\"Shimla\")]/ancestor::div[@class='SKUDeck___StyledDiv-sc-1e5d9gk-0 bFjDCO']/descendant::button[text()='Add']")).click();
		
		//validating whether product is added to cart or not
		String validate = driver.findElement(By.xpath("//p[text()=\"An item has been added to your basket successfully\"]")).getText();
		if(validate.contains("added to your basket successfully"))
		{
			System.out.println("Product has been added");
		}
		else
		{
			System.out.println("Product is not added");
		}
		
		driver.quit();
	}

}
