<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>SwagLabsProject</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Default TestNG suite -->
        <suiteXmlFile>AllTests.xml</suiteXmlFile>

        <!-- Default browser -->
        <browser>chrome</browser>
    </properties>

    <dependencies>

        <!-- Override the vulnerable transitive Log4j API version -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.25.5</version>
        </dependency>


        <!-- Selenium WebDriver -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>4.49.0</version>
        </dependency>

        <!-- Excel test data -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>

        <!-- TestNG -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.12.0</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Java compilation -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- TestNG suite execution -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                    </suiteXmlFiles>

                    <systemPropertyVariables>
                        <browser>${browser}</browser>
                    </systemPropertyVariables>

                    <useFile>true</useFile>
                </configuration>
            </plugin>

            <!-- Generate Surefire test reports -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>

        </plugins>
    </build>

    <!-- Maven execution profiles -->
    <profiles>

        <!-- RT: Regression Testing -->
        <profile>
            <id>RT</id>
            <properties>
                <suiteXmlFile>AllTests.xml</suiteXmlFile>
            </properties>
        </profile>

        <!-- ST: System Testing -->
        <profile>
            <id>ST</id>
            <properties>
                <suiteXmlFile>SystemGrp.xml</suiteXmlFile>
            </properties>
        </profile>

        <!-- RRT: Regional Regression Testing -->
        <profile>
            <id>RRT</id>
            <properties>
                <suiteXmlFile>IntegrationGrp.xml</suiteXmlFile>
            </properties>
        </profile>

        <!-- Failed Test Suite -->
        <profile>
            <id>FailedTS</id>
            <properties>
                <suiteXmlFile>testng-failed.xml</suiteXmlFile>
            </properties>
        </profile>

    </profiles>

</project>
